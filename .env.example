# Sao chép file này thành .env và thay các giá trị phù hợp với môi trường.
# Không commit file .env hoặc mật khẩu thật lên Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop_caulong
DB_USER=shop_app
DB_PASSWORD=replace-with-a-strong-password

# Chỉ điền khi máy chủ MySQL yêu cầu một CA riêng để xác minh TLS.
DB_SSL_CA=

# Danh sách origin frontend, phân tách bằng dấu phẩy; không dùng dấu *.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_DAYS=7
PASSWORD_RESET_MINUTES=30

# URL công khai chính xác của website; dùng để tạo liên kết đặt lại mật khẩu.
PUBLIC_BASE_URL=https://your-account.alwaysdata.net

# SMTP dùng cho email đặt lại mật khẩu. Nếu nhà cung cấp yêu cầu SSL trực tiếp
# (thường cổng 465), đặt SMTP_USE_SSL=1; STARTTLS thường dùng cổng 587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_USE_SSL=0
SMTP_USE_STARTTLS=1

# Alwaysdata đứng sau một reverse proxy: đặt 1 trên máy chủ, giữ 0 khi chạy local.
# Không tăng giá trị nếu nhà cung cấp không xác nhận số proxy trung gian.
TRUST_PROXY_HOPS=0

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Chỉ đặt =1 tạm thời cho đúng một lần chạy lệnh promote-superadmin qua SSH.
ALLOW_SUPERADMIN_BOOTSTRAP=0

# Thông tin nhận chuyển khoản công khai để sinh mã VietQR. BANK_BIN là mã
# NAPAS 6 chữ số của ngân hàng; không đặt mật khẩu hay OTP ở đây.
BANK_BIN=
BANK_CODE=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
